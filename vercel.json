{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/customers", "destination": "/index.html" },
    { "source": "/customers/", "destination": "/index.html" },
    { "source": "/customers/ey", "destination": "/ey/index.html" },
    { "source": "/customers/ey/", "destination": "/ey/index.html" },
    { "source": "/customers/yogifi", "destination": "/yogifi/index.html" },
    { "source": "/customers/yogifi/", "destination": "/yogifi/index.html" },
    { "source": "/customers/insignian-homes", "destination": "/insignian-homes/index.html" },
    { "source": "/customers/insignian-homes/", "destination": "/insignian-homes/index.html" },
    { "source": "/customers/security-incident-response", "destination": "/security-incident-response/index.html" },
    { "source": "/customers/security-incident-response/", "destination": "/security-incident-response/index.html" },
    { "source": "/customers/img/:path*", "destination": "/img/:path*" },
    { "source": "/ey", "destination": "/ey/index.html" },
    { "source": "/ey/", "destination": "/ey/index.html" },
    { "source": "/yogifi", "destination": "/yogifi/index.html" },
    { "source": "/yogifi/", "destination": "/yogifi/index.html" },
    { "source": "/insignian-homes", "destination": "/insignian-homes/index.html" },
    { "source": "/insignian-homes/", "destination": "/insignian-homes/index.html" },
    { "source": "/security-incident-response", "destination": "/security-incident-response/index.html" },
    { "source": "/security-incident-response/", "destination": "/security-incident-response/index.html" }
  ]
}
